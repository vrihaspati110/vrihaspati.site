---
interface Props {
  videoUrl?: string;
  youtubeId?: string;
  vimeoId?: string;
  title: string;
  softwareTag: string;
  role?: string;
  client?: string;
  logline?: string;
  aspectBadge?: string;
  category: string;
  isVertical?: boolean;
}

const { 
  videoUrl, 
  youtubeId,
  vimeoId,
  title, 
  softwareTag, 
  role, 
  client, 
  logline, 
  aspectBadge = '16:9 4K', 
  category,
  isVertical = false
} = Astro.props;

// Determine embed source URL
let embedSrc = videoUrl || '';
if (youtubeId) {
  embedSrc = `https://www.youtube.com/embed/${youtubeId}?rel=0&modestbranding=1`;
} else if (vimeoId) {
  embedSrc = `https://player.vimeo.com/video/${vimeoId}?color=0066ff&title=0&byline=0&portrait=0`;
}
---

<article 
  class={`portfolio-card ${isVertical ? 'vertical-card' : ''}`} 
  data-category={category}
>
  <div class={`video-wrapper ${isVertical ? 'aspect-vertical' : 'aspect-widescreen'}`}>
    {embedSrc ? (
      <iframe 
        src={embedSrc} 
        title={title} 
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen>
      </iframe>
    ) : (
      <div class="video-placeholder">
        <div class="play-icon-glow">
          <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <span class="placeholder-label">Video Preview</span>
      </div>
    )}
    {aspectBadge && <span class="aspect-badge">{aspectBadge}</span>}
  </div>

  <div class="card-details">
    <div class="title-row">
      <h3 class="card-title">{title}</h3>
      <span class="tag">{softwareTag}</span>
    </div>

    {(role || client) && (
      <p class="card-meta">
        {client && <span class="client">{client}</span>}
        {role && client && <span class="divider">•</span>}
        {role && <span class="role">{role}</span>}
      </p>
    )}

    {logline && <p class="card-logline">{logline}</p>}
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #0f1117;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.15rem;
    transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45), 0 0 25px rgba(37, 99, 235, 0.15);
  }

  .portfolio-card.is-hidden {
    display: none !important;
  }

  .vertical-card {
    grid-row: span 2;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    background: #07090e;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .aspect-widescreen {
    aspect-ratio: 16 / 9;
  }

  .aspect-vertical {
    aspect-ratio: 9 / 16;
    max-height: 520px;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(145deg, #131722 0%, #090b10 100%);
    color: #64748b;
  }

  .play-icon-glow {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #60a5fa;
    transition: transform 0.2s, background 0.2s;
  }

  .portfolio-card:hover .play-icon-glow {
    transform: scale(1.1);
    background: rgba(37, 99, 235, 0.3);
    color: #ffffff;
  }

  .placeholder-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .aspect-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(8, 10, 15, 0.85);
    backdrop-filter: blur(8px);
    color: #e2e8f0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    padding: 0.22rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: none;
    text-transform: uppercase;
  }

  .card-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .card-title {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
    color: #f1f5f9;
    line-height: 1.35;
    letter-spacing: -0.2px;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: 0.4px;
  }

  .card-meta {
    margin: 0;
    font-size: 0.84rem;
    font-weight: 500;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .client {
    color: #e2e8f0;
    font-weight: 600;
  }

  .divider {
    color: #3b82f6;
  }

  .card-logline {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.55;
    color: #cbd5e1;
  }
</style>
