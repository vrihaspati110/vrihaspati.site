---
interface Props {
  videoUrl: string;
  title: string;
  softwareTag: string;
  role?: string;
  client?: string;
  logline?: string;
  aspectBadge?: string;
  category?: string;
}

const { 
  videoUrl, 
  title, 
  softwareTag, 
  role, 
  client, 
  logline, 
  aspectBadge, 
  category 
} = Astro.props;

// Extract YouTube ID from various YouTube URL formats
const ytMatch = videoUrl?.match(/(?:embed\/|v=|youtu\.be\/|\/v\/)([a-zA-Z0-9_-]{11})/);
const youtubeId = ytMatch ? ytMatch[1] : null;
const posterUrl = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg` : null;
---

<article class="portfolio-card" data-category={category}>
  <div 
    class="video-wrapper custom-facade" 
    data-youtube-id={youtubeId}
    data-video-url={videoUrl}
    data-title={title}
    role={posterUrl ? "button" : undefined}
    tabindex={posterUrl ? "0" : undefined}
    aria-label={posterUrl ? `Play video: ${title}` : undefined}
  >
    {posterUrl ? (
      <div class="poster-container" title={`Click to play: ${title}`}>
        <img 
          src={posterUrl} 
          alt={title} 
          class="poster-image" 
          loading="lazy" 
          decoding="async" 
        />
        <div class="poster-overlay">
          <div class="custom-play-btn" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" style="margin-left: 2px;">
              <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.78-6.86a1 1 0 0 0 0-1.68L9.54 4.3a1 1 0 0 0-1.54.84z"/>
            </svg>
          </div>
        </div>
      </div>
    ) : (
      <iframe 
        src={videoUrl} 
        title={title} 
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen>
      </iframe>
    )}
    {aspectBadge && <span class="aspect-badge">{aspectBadge}</span>}
  </div>

  <div class="card-details">
    <div class="title-group">
      <div class="title-row">
        <h3>{title}</h3>
        <span class="tag">{softwareTag}</span>
      </div>
      {(role || client) && (
        <p class="card-meta">
          {role && <span class="role">{role}</span>}
          {role && client && <span class="divider">/</span>}
          {client && <span class="client">{client}</span>}
        </p>
      )}
      {logline && <p class="card-logline">{logline}</p>}
    </div>
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .portfolio-card:hover {
    transform: translateY(-5px);
  }
  .portfolio-card.is-hidden {
    display: none;
  }
  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #08080a;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .portfolio-card:hover .video-wrapper {
    box-shadow: 0 14px 35px var(--card-glow, rgba(10, 30, 226, 0.2));
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Custom Facade & Clean Play Button */
  .custom-facade {
    cursor: pointer;
  }
  .custom-facade:focus-visible {
    outline: 2px solid var(--blue, #0a1ee2);
    outline-offset: 3px;
  }
  .poster-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .poster-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.4s ease;
  }
  .portfolio-card:hover .poster-image {
    transform: scale(1.03);
    filter: brightness(1.04);
  }
  .poster-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 8, 10, 0.2);
    transition: background 0.3s ease;
  }
  .portfolio-card:hover .poster-overlay {
    background: rgba(8, 8, 10, 0.08);
  }
  .custom-play-btn {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(8, 10, 18, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
    transition: transform 0.24s ease, background 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
  }
  .portfolio-card:hover .custom-play-btn {
    transform: scale(1.1);
    background: var(--blue, #0a1ee2);
    border-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 12px 32px var(--blue-glow, rgba(10, 30, 226, 0.4));
  }

  .aspect-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(6px);
    color: rgba(255, 255, 255, 0.9);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.22rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: none;
    transition: border-color 0.3s ease, color 0.3s ease;
    text-transform: uppercase;
  }
  .portfolio-card:hover .aspect-badge {
    border-color: rgba(10, 30, 226, 0.6);
    color: #ffffff;
  }
  .card-details {
    display: flex;
    flex-direction: column;
  }
  .title-group {
    display: flex;
    flex-direction: column;
  }
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }
  .title-row h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--card-title-color, #111);
    font-family: 'Inter', sans-serif;
    line-height: 1.25;
    letter-spacing: -0.2px;
  }
  .tag {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--card-tag-color, #0a1ee2);
    font-family: 'Plus Jakarta Sans', sans-serif;
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
  .card-meta {
    margin: 0 0 0.35rem 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--card-meta-color, #606470);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .card-meta .divider {
    color: var(--card-tag-color, #0a1ee2);
    opacity: 0.6;
    font-weight: 700;
  }
  .card-logline {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--card-logline-color, #454852);
  }
</style>
