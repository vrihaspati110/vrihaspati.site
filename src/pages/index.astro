---
import VideoEmbed from '../components/VideoEmbed.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vrihaspati Tiwari | Corporate & Event Video Editor</title>
  <meta name="description" content="Portfolio of Vrihaspati Tiwari — Professional video editor specializing in corporate films, global conference aftermovies, product launches, executive keynotes, and multicam event post-production." />
  
  <link rel="canonical" href="https://vrihaspati.site/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://vrihaspati.site/" />
  <meta property="og:title" content="Vrihaspati Tiwari | Corporate & Event Video Editor" />
  <meta property="og:description" content="High-impact corporate event films, brand stories, keynote summaries, aftermovies, and rapid social cutdowns." />
  <meta property="og:image" content="https://vrihaspati.site/profile.jpg" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://vrihaspati.site/" />
  <meta property="twitter:title" content="Vrihaspati Tiwari | Corporate & Event Video Editor" />
  <meta property="twitter:description" content="High-impact corporate event films, brand stories, keynote summaries, aftermovies, and rapid social cutdowns." />
  <meta property="twitter:image" content="https://vrihaspati.site/profile.jpg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-primary: #07090e;
      --bg-secondary: #0d111a;
      --bg-card: #121722;
      --bg-card-hover: #171d2b;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-highlight: rgba(59, 130, 246, 0.4);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --accent-blue: #2563eb;
      --accent-cyan: #06b6d4;
      --accent-indigo: #4f46e5;
      --accent-glow: rgba(37, 99, 235, 0.25);
      --font-display: 'Syne', sans-serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--bg-primary);
      color: var(--text-main);
      font-family: var(--font-body);
    }

    body {
      overflow-x: hidden;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* Container Utilities */
    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section-spacing {
      padding: 6.5rem 0;
      position: relative;
    }

    /* Navigation Bar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background: rgba(7, 9, 14, 0.85);
      border-bottom: 1px solid var(--border-subtle);
      transition: all 0.3s ease;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.1rem 0;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid var(--accent-blue);
      object-fit: cover;
    }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: -0.3px;
    }

    .brand-tag {
      font-size: 0.72rem;
      color: var(--accent-cyan);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      display: block;
      margin-top: -3px;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }

    .nav-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .nav-link:hover {
      color: #ffffff;
    }

    .availability-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 10px #10b981;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }

    .btn-nav-cta {
      background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-indigo) 100%);
      color: #ffffff;
      padding: 0.6rem 1.3rem;
      border-radius: 8px;
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-nav-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px var(--accent-glow);
    }

    /* Hero Section */
    .hero-section {
      padding: 5.5rem 0 4.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero-glow-1 {
      position: absolute;
      top: -10%;
      left: 20%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(37, 99, 235, 0.18) 0%, transparent 70%);
      pointer-events: none;
      filter: blur(80px);
    }

    .hero-glow-2 {
      position: absolute;
      top: 15%;
      right: 10%;
      width: 450px;
      height: 450px;
      background: radial-gradient(circle, rgba(6, 182, 212, 0.12) 0%, transparent 70%);
      pointer-events: none;
      filter: blur(80px);
    }

    .hero-content {
      max-width: 960px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 1.75rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 5.8vw, 4.8rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -1px;
      margin-bottom: 1.6rem;
      color: #ffffff;
    }

    .hero-headline .gradient-text {
      background: linear-gradient(135deg, #60a5fa 0%, #38bdf8 50%, #c084fc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subhead {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: var(--text-muted);
      line-height: 1.75;
      max-width: 780px;
      margin: 0 auto 2.5rem;
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      margin-bottom: 3.5rem;
    }

    .btn-primary {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff;
      padding: 0.95rem 2.2rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.94rem;
      text-decoration: none;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 35px rgba(37, 99, 235, 0.5);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: #e2e8f0;
      padding: 0.95rem 2.2rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.94rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    /* Metric Cards Strip */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .metric-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 1.5rem 1.25rem;
      text-align: left;
      transition: border-color 0.2s;
    }

    .metric-card:hover {
      border-color: var(--border-highlight);
    }

    .metric-number {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1;
      margin-bottom: 0.35rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .metric-number span {
      color: var(--accent-cyan);
    }

    .metric-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Section Headers */
    .section-header {
      margin-bottom: 3.25rem;
    }

    .section-badge {
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--accent-cyan);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      display: inline-block;
      margin-bottom: 0.75rem;
    }

    .section-heading {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.2rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.5px;
      color: #ffffff;
      margin-bottom: 1rem;
    }

    .section-description {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 680px;
      line-height: 1.7;
    }

    /* Showreel Spotlight Section */
    .spotlight-wrapper {
      position: relative;
      background: linear-gradient(180deg, #101522 0%, #090c13 100%);
      border: 1px solid var(--border-highlight);
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      margin-bottom: 3rem;
    }

    .spotlight-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .spotlight-tag {
      background: rgba(37, 99, 235, 0.2);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #60a5fa;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 0.3rem 0.8rem;
      border-radius: 6px;
    }

    .spotlight-video {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000000;
      border-radius: 10px;
      overflow: hidden;
    }

    .spotlight-video iframe {
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* Filter Bar */
    .filter-bar {
      display: flex;
      gap: 0.65rem;
      flex-wrap: wrap;
      margin-bottom: 2.75rem;
      background: rgba(255, 255, 255, 0.03);
      padding: 0.5rem;
      border-radius: 12px;
      border: 1px solid var(--border-subtle);
      width: fit-content;
    }

    .filter-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.6rem 1.15rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }

    .filter-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.06);
    }

    .filter-btn.active {
      background: var(--accent-blue);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .filter-count {
      font-size: 0.7rem;
      opacity: 0.8;
      background: rgba(0, 0, 0, 0.3);
      padding: 0.1rem 0.45rem;
      border-radius: 9999px;
    }

    /* Portfolio Cards Grid */
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2rem;
    }

    @media (max-width: 640px) {
      .portfolio-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Capabilities / Services Grid */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .service-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 2.25rem 2rem;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .service-card:hover {
      border-color: var(--border-highlight);
      transform: translateY(-4px);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    }

    .service-icon {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: rgba(37, 99, 235, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #60a5fa;
    }

    .service-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      color: #ffffff;
    }

    .service-text {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .service-list {
      list-style: none;
      margin-top: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .service-list li {
      font-size: 0.84rem;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .service-list li::before {
      content: "✓";
      color: var(--accent-cyan);
      font-weight: bold;
    }

    /* Workflow Timeline */
    .workflow-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      position: relative;
    }

    .step-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 1.8rem 1.5rem;
      position: relative;
    }

    .step-number {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 800;
      color: rgba(255, 255, 255, 0.15);
      margin-bottom: 0.8rem;
    }

    .step-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }

    .step-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Tools Strip */
    .tools-strip {
      background: var(--bg-secondary);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
      padding: 3rem 0;
    }

    .tools-label {
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--text-dim);
      margin-bottom: 1.5rem;
    }

    .tools-list {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 2.5rem;
    }

    .tool-badge {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #cbd5e1;
      padding: 0.6rem 1.25rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
    }

    /* About Section */
    .about-wrapper {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 3.5rem;
      align-items: center;
    }

    @media (max-width: 860px) {
      .about-wrapper {
        grid-template-columns: 1fr;
      }
    }

    .about-image-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border-subtle);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }

    .about-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .about-badge-floating {
      position: absolute;
      bottom: 16px;
      left: 16px;
      right: 16px;
      background: rgba(10, 14, 23, 0.85);
      backdrop-filter: blur(10px);
      padding: 0.8rem 1rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.82rem;
      color: #e2e8f0;
      text-align: center;
    }

    .about-bio {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .about-bio p {
      color: var(--text-muted);
      font-size: 1.02rem;
      line-height: 1.8;
    }

    .about-bio strong {
      color: #ffffff;
    }

    /* Contact / Booking Section */
    .contact-card {
      background: linear-gradient(135deg, #101625 0%, #0a0d16 100%);
      border: 1px solid var(--border-highlight);
      border-radius: 20px;
      padding: 4rem 3rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 640px) {
      .contact-card {
        padding: 2.5rem 1.5rem;
      }
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3.5rem;
    }

    @media (max-width: 860px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    .contact-info-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .contact-info-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 1rem;
      color: #cbd5e1;
    }

    .contact-info-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(37, 99, 235, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #60a5fa;
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-label {
      font-size: 0.82rem;
      font-weight: 600;
      color: #cbd5e1;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-input, .form-textarea, .form-select {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      padding: 0.85rem 1.1rem;
      border-radius: 8px;
      color: #ffffff;
      font-family: var(--font-body);
      font-size: 0.94rem;
      transition: border-color 0.2s, background 0.2s;
    }

    .form-input:focus, .form-textarea:focus, .form-select:focus {
      outline: none;
      border-color: var(--accent-blue);
      background: rgba(255, 255, 255, 0.08);
      box-shadow: 0 0 15px rgba(37, 99, 235, 0.2);
    }

    .form-textarea {
      resize: vertical;
      min-height: 110px;
    }

    /* Footer */
    .footer {
      border-top: 1px solid var(--border-subtle);
      padding: 3rem 0;
      background: var(--bg-primary);
      color: var(--text-dim);
      font-size: 0.88rem;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .cloudflare-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(246, 130, 31, 0.1);
      border: 1px solid rgba(246, 130, 31, 0.3);
      color: #f6821f;
      padding: 0.3rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
    }
  </style>
</head>

<body>
  <!-- Top Sticky Navigation -->
  <header class="navbar">
    <div class="container nav-inner">
      <a href="#" class="brand-logo">
        <img src="/profile.jpg" alt="Vrihaspati Tiwari" class="brand-avatar" />
        <div>
          <span class="brand-title">Vrihaspati Tiwari</span>
          <span class="brand-tag">Corporate & Event Video Editor</span>
        </div>
      </a>

      <ul class="nav-menu">
        <li><a href="#work" class="nav-link">Work</a></li>
        <li><a href="#showreel" class="nav-link">Showreel</a></li>
        <li><a href="#services" class="nav-link">Capabilities</a></li>
        <li><a href="#workflow" class="nav-link">Workflow</a></li>
        <li><a href="#about" class="nav-link">About</a></li>
      </ul>

      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <span class="availability-pill">
          <span class="pulse-dot"></span>
          Booking Q1/Q2 2026
        </span>
