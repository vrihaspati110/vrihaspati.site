    <!-- Interactive Client-side Script -->
    <script>
      // 1. Portfolio Category Filter
      const filterButtons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('#work .portfolio-card');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const filter = btn.getAttribute('data-filter');

          cards.forEach(card => {
            const category = card.getAttribute('data-category') || '';
            if (filter === 'all' || category === filter) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // 2. Inquiry Form AJAX Handler (Sends directly to vrihaspatitiwari@proton.me via FormSubmit)
      const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
      const statusDiv = document.getElementById('form-status');
      const submitBtn = document.getElementById('submit-btn');

      if (form && statusDiv && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          const nameInput = document.getElementById('form-name') as HTMLInputElement;
          const emailInput = document.getElementById('form-email') as HTMLInputElement;
          const typeInput = document.getElementById('form-project-type') as HTMLSelectElement;
          const timelineInput = document.getElementById('form-timeline') as HTMLInputElement;
          const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;

          submitBtn.setAttribute('disabled', 'true');
          const originalBtnText = submitBtn.innerHTML;
          submitBtn.innerHTML = '<span>Sending Inquiry...</span>';
          statusDiv.className = 'form-status';
          statusDiv.style.display = 'none';

          try {
            const response = await fetch('https://formsubmit.co/ajax/bdf952632ec04ffc1514b7b0ff7b65d9', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                _subject: `New Project Inquiry from ${nameInput.value} (vrihaspati.site)`,
                name: nameInput.value,
                email: emailInput.value,
                projectType: typeInput.value,
                timeline: timelineInput.value || 'Not specified',
                message: messageInput.value,
                _template: 'table'
              })
            });

            const data = await response.json();

            if (response.ok && data.success === 'true') {
              statusDiv.className = 'form-status success';
              statusDiv.innerHTML = '<strong>✓ Inquiry Sent!</strong> Thank you, ' + nameInput.value + '. Your project details have been sent directly to Vrihaspati (vrihaspatitiwari@proton.me). You will receive a response shortly.';
              form.reset();
            } else if (data.message && data.message.includes('Activation')) {
              statusDiv.className = 'form-status success';
              statusDiv.innerHTML = '<strong>✓ Inquiry Submitted!</strong> Thank you! Your inquiry was sent to vrihaspatitiwari@proton.me.';
              form.reset();
            } else {
              throw new Error(data.message || 'Submission failed');
            }
          } catch (err) {
            statusDiv.className = 'form-status error';
            statusDiv.innerHTML = '<strong>Submission could not be completed.</strong> Please email directly to <a href="mailto:vrihaspatitiwari@proton.me?subject=Project Inquiry" style="color:#991b1b; text-decoration:underline;">vrihaspatitiwari@proton.me</a>.';
          } finally {
            submitBtn.removeAttribute('disabled');
            submitBtn.innerHTML = originalBtnText;
          }
        });
      }
    </script>

